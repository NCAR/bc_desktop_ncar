---
cluster: 
  - "casper"
  - "derecho"

form:
  - bc_vnc_idle
  - account
  - bc_num_hours
  - bc_num_slots
  - node_type
  - gpu_type
  - queue
  - bc_vnc_resolution
  - bc_email_on_started

attributes:
  bc_vnc_idle: 0
  bc_vnc_resolution:
    required: true
  node_type: null
  account:
    label: "Account"
    widget: select
    help: "Select the account to charge for this job."
    options:
      <%- CustomAccounts.accounts["cr"].each do |account| %>
       - [
         "<%= account.strip %> Casper", "<%= account.strip %>",
         data-option-for-cluster-derecho: false
         ]
    <%- end %>
      <%- CustomAccounts.accounts["de"].each do |account| %>
       - [
         "<%= account.strip %> Derecho", "<%= account.strip %>",
         data-option-for-cluster-casper: false
         ]
    <%- end %>
  queue:
    label: "Queue"
    widget: select
    options:
      <%- CustomQueues.queues["cr"].each do |queue| %>
      - [ "<%= queue.strip %>", "<%= queue.strip %>",
          data-exclusive-option-for-cluster-casper: true ]
    <%- end %>
      <%- CustomQueues.queues["de"].each do |queue| %>
      - [ "<%= queue.strip %>", "<%= queue.strip %>",
          data-exclusive-option-for-cluster-derecho: true ]
    <%- end %>
    cacheable: false
  gpu_type:
    widget: "select"
    label: "GPU type"
    required: true
    value: "vis"
    options:
      - ["Any", "vis"]
      - ["GP100", "gp100"]
      - ["L40", "l40"]
